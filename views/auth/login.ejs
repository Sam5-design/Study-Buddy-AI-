<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in — Study Buddy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='18' fill='%23df6d60'/%3E%3Ctext x='32' y='45' text-anchor='middle' font-size='36' fill='white'%3E✦%3C/text%3E%3C/svg%3E" />
  </head>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-pitch" aria-label="Study Buddy introduction">
        <a class="brand" href="/" aria-label="Study Buddy home"><span class="brand-mark" aria-hidden="true">✦</span><span>Study<span>Buddy</span></span></a>
        <p class="eyebrow">Welcome back</p>
        <h1>Your week is waiting.</h1>
        <p>Pick up where you left off and keep your next study session in sight.</p>
      </section>
      <section class="auth-card" aria-labelledby="login-heading">
        <h2 id="login-heading">Welcome back</h2>
        <p>Log in to see your subjects, tasks, and weekly study plan.</p>
        <form class="auth-form" data-mode="login">
          <div class="input-field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
          <div class="input-field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required /></div>
          <div class="auth-options"><label><input type="checkbox" name="remember" /><span>Remember me</span></label><a href="#forgot-password">Forgot password?</a></div>
          <button class="button auth-submit" type="submit">Login <span aria-hidden="true">→</span></button>
          <p class="auth-message" role="status" aria-live="polite"></p>
          <p class="auth-switch">Don't have an account? <a href="/register">Create account</a></p>
        </form>
        <a class="auth-back" href="/">← Back to homepage</a>
      </section>
    </main>
    <script src="/js/auth.js"></script>
  </body>
</html>