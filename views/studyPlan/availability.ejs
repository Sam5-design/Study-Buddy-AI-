<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set Your Study Time — Study Buddy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <main class="container" style="padding-top: 2rem; padding-bottom: 4rem; max-width: 640px;">
      <form action="/logout" method="POST" style="float:right; margin-top: 0.5rem;">
        <button type="submit" class="btn-flat">Log out</button>
      </form>
      <p class="grey-text">STEP 3 OF 3</p>
      <h1 style="font-family: 'Fraunces', serif;">Set your study time</h1>
      <p>How many hours a day can you realistically study, and when do you usually start? We'll use this to build your plan.</p>

      <% if (error) { %>
        <div class="card-panel red lighten-4 red-text text-darken-4"><%= error %></div>
      <% } %>

      <form action="/study-plan/availability" method="POST" class="card-panel">
        <label for="availableStudyTimeHours">Hours per day</label>
        <input
          type="number"
          id="availableStudyTimeHours"
          name="availableStudyTimeHours"
          min="0.5"
          max="16"
          step="0.5"
          value="<%= hours %>"
          required
        />

        <label for="studyStartTime">What time do you usually start studying?</label>
        <input
          type="time"
          id="studyStartTime"
          name="studyStartTime"
          value="<%= startTime %>"
          required
        />

        <label for="sessionLengthMinutes">How long should one study session be?</label>
        <select id="sessionLengthMinutes" name="sessionLengthMinutes" class="browser-default" style="margin-bottom:1rem;">
          <% [30, 60, 90, 120].forEach(function (m) { %>
            <option value="<%= m %>" <%= Number(sessionLength) === m ? 'selected' : '' %>>
              <%= m < 60 ? m + ' minutes' : (m / 60) + (m === 60 ? ' hour' : ' hours') %>
            </option>
          <% }); %>
        </select>

        <%
          // Unavailable days (Sprint 2): days the plan must skip.
          const blockedDays = typeof unavailableDates !== 'undefined' ? unavailableDates : [];
          const prettyDay = (d) => new Date(d + 'T00:00:00').toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        %>
        <label for="unavailableDateInput">Days you can't study</label>
        <p class="grey-text" style="margin: 0.25rem 0 0.5rem;">Work shifts, holidays or appointments. Your plan will skip these days and fit the work into the others.</p>
        <div style="display: flex; gap: 0.5rem; align-items: center;">
          <input type="date" id="unavailableDateInput" style="flex: 1;" />
          <button type="button" class="btn-flat" id="addUnavailableDate">+ Add day</button>
        </div>
        <ul id="unavailableDateList" style="margin: 0 0 1rem;">
          <% blockedDays.forEach(function (d) { %>
            <li data-date="<%= d %>" style="display: flex; justify-content: space-between; align-items: center; padding: 0.25rem 0; border-bottom: 1px solid #eee;">
              <span><%= prettyDay(d) %></span>
              <input type="hidden" name="unavailableDates" value="<%= d %>" />
              <button type="button" class="btn-flat remove-day" aria-label="Remove this day">✕</button>
            </li>
          <% }); %>
        </ul>
        <p id="noUnavailableDates" class="grey-text" style="margin-top: 0; <%= blockedDays.length ? 'display: none;' : '' %>">No days blocked.</p>

        <button class="btn" type="submit">Save and continue →</button>
      </form>

      <a href="/study-plan">← Back to dashboard</a> &nbsp;·&nbsp; <a href="/subjects/new">Add a subject</a>
    </main>
    <script>
      // Unavailable days: add and remove days in the list before saving.
      (function () {
        const input = document.getElementById('unavailableDateInput');
        const list = document.getElementById('unavailableDateList');
        const empty = document.getElementById('noUnavailableDates');
        const now = new Date();
        const pad = (n) => String(n).padStart(2, '0');
        input.min = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());

        function refreshEmptyMessage() {
          empty.style.display = list.children.length ? 'none' : '';
        }

        document.getElementById('addUnavailableDate').addEventListener('click', function () {
          const value = input.value;
          if (!value || value < input.min) return;
          if (list.querySelector('[data-date="' + value + '"]')) return; // already in the list

          const item = document.createElement('li');
          item.dataset.date = value;
          item.style.cssText = 'display: flex; justify-content: space-between; align-items: center; padding: 0.25rem 0; border-bottom: 1px solid #eee;';
          const label = document.createElement('span');
          label.textContent = new Date(value + 'T00:00:00').toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
          const hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = 'unavailableDates';
          hidden.value = value;
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'btn-flat remove-day';
          remove.setAttribute('aria-label', 'Remove this day');
          remove.textContent = '✕';
          item.append(label, hidden, remove);

          // Keep the list in date order.
          const after = Array.from(list.children).find((li) => li.dataset.date > value);
          list.insertBefore(item, after || null);
          input.value = '';
          refreshEmptyMessage();
        });

        list.addEventListener('click', function (event) {
          if (event.target.classList.contains('remove-day')) {
            event.target.closest('li').remove();
            refreshEmptyMessage();
          }
        });
      })();
    </script>
    <script src="/js/theme.js" defer></script>
  </body>
</html>
