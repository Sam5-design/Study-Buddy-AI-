<%
  // Soft background for a subject colour, e.g. '#E56B61' -> '#E56B6133'.
  function tint(hex, alpha) {
    return /^#[0-9a-fA-F]{6}$/.test(hex || '') ? hex + alpha : 'rgba(38,166,154,0.2)';
  }
  function clock(hhmm) {
    var p = String(hhmm || '18:00').split(':');
    var h = Number(p[0]);
    return ((h % 12) || 12) + ':' + p[1] + (h >= 12 ? ' PM' : ' AM');
  }
  // Circular progress ring (conic-gradient) used on the dashboard cards.
  function ring(percent, colour, size) {
    size = size || 64;
    var inner = Math.round(size * 0.72);
    return '<div class="sb-ring" style="width:' + size + 'px;height:' + size + 'px;background:conic-gradient(' +
      (colour || 'var(--coral)') + ' ' + percent + '%, #ddd4c7 0);">' +
      '<span style="width:' + inner + 'px;height:' + inner + 'px;">' + percent + '%</span></div>';
  }
  var displayName = (user && (user.fullName || user.email)) || 'Student';
  var initials = displayName.split(/\s+/).map(function (w) { return w.charAt(0); }).join('').slice(0, 2).toUpperCase();
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Study Plan — Study Buddy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --navy: #14233c;
        --coral: #e56b61;
        --cream: #f8f4ee;
        --sand: #efe7dc;
        --card: #fffdf9;
        --line: #e4ddd2;
        --muted: #7a8494;
        --green: #2e9e8f;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--navy); }
      a { color: inherit; text-decoration: none; }
      button { font-family: inherit; }

      /* ---------- Layout ---------- */
      .sb-app { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
      .sb-side { background: var(--sand); padding: 28px 20px; display: flex; flex-direction: column; gap: 28px; }
      .sb-main { padding: 32px 40px 48px; min-width: 0; }

      /* ---------- Sidebar ---------- */
      .sb-logo { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.15rem; }
      .sb-logo-box { width: 34px; height: 34px; border-radius: 9px; background: var(--coral); color: #fff; display: grid; place-items: center; }
      .sb-logo span span { color: var(--coral); font-weight: 500; }
      .sb-nav { display: flex; flex-direction: column; gap: 6px; }
      .sb-nav a { padding: 12px 14px; border-radius: 12px; font-weight: 600; font-size: 0.95rem; display: flex; gap: 10px; align-items: center; }
      .sb-nav a:hover { background: rgba(255, 255, 255, 0.5); }
      .sb-nav a.active { background: #fbdcd8; }
      .sb-side-label { font-size: 0.7rem; letter-spacing: 0.12em; font-weight: 700; color: var(--muted); margin: 0 0 8px; }
      .sb-avail { border-top: 1px solid var(--line); padding-top: 20px; font-size: 0.85rem; line-height: 1.6; }
      .sb-avail a { color: var(--coral); font-weight: 600; font-size: 0.8rem; }
      .sb-logout { margin-top: auto; }
      .sb-logout button { background: none; border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; cursor: pointer; color: var(--navy); font-weight: 600; }

      /* ---------- Header ---------- */
      .sb-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
      .sb-date { font-size: 0.72rem; letter-spacing: 0.12em; font-weight: 700; color: var(--muted); text-transform: uppercase; margin: 0; }
      .sb-title { font-family: 'Fraunces', serif; font-size: 2rem; margin: 6px 0 0; display: flex; align-items: center; gap: 10px; }
      .sb-title::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
      .sb-avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--coral); color: #fff; font-weight: 700; display: grid; place-items: center; flex-shrink: 0; }
      .sb-profile { position: relative; }
      .sb-profile summary { list-style: none; cursor: pointer; }
      .sb-profile summary::-webkit-details-marker { display: none; }
      .sb-profile[open] summary { box-shadow: 0 0 0 3px #fbdcd8; }
      .sb-menu { position: absolute; right: 0; top: 54px; width: 250px; background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 12px 32px rgba(20, 35, 60, 0.14); padding: 8px; z-index: 20; }
      .sb-menu-head { padding: 10px 12px 12px; border-bottom: 1px solid var(--line); margin-bottom: 6px; display: flex; flex-direction: column; gap: 2px; }
      .sb-menu-head span { color: var(--muted); font-size: 0.8rem; overflow: hidden; text-overflow: ellipsis; }
      .sb-menu a, .sb-menu button { display: block; width: 100%; text-align: left; padding: 10px 12px; border-radius: 10px; font-size: 0.9rem; font-weight: 600; background: none; border: none; cursor: pointer; color: var(--navy); }
      .sb-menu a:hover, .sb-menu button:hover { background: var(--cream); }
      .sb-menu form { margin: 0; border-top: 1px solid var(--line); margin-top: 6px; padding-top: 6px; }
      .sb-menu button { color: #b3423a; }

      .sb-subjects { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 24px 0; }
      .sb-chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; font-size: 0.8rem; font-weight: 700; }
      .sb-chip i { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
      .sb-chip-add { border: 1px dashed #cfc6b8; color: var(--muted); font-weight: 600; }

      /* ---------- Cards ---------- */
      .sb-card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 22px 24px; }
      .sb-card-head { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
      .sb-card-head h2 { font-size: 1.05rem; margin: 4px 0 0; font-weight: 600; }
      .sb-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .sb-pill { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 7px 14px; font-size: 0.8rem; font-weight: 600; cursor: pointer; color: var(--navy); }
      .sb-pill.primary { background: var(--navy); color: #fff; border-color: var(--navy); }
      .sb-toggle { display: inline-flex; background: var(--sand); border-radius: 999px; padding: 3px; }
      .sb-toggle a { padding: 6px 14px; border-radius: 999px; font-size: 0.8rem; font-weight: 600; }
      .sb-toggle a.active { background: var(--navy); color: #fff; }

      .sb-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
      .sb-stat { background: var(--sand); border-radius: 18px; padding: 20px 22px; }
      .sb-stat-big { font-family: 'Fraunces', serif; font-size: 1.8rem; margin: 6px 0 2px; }
      .sb-stat-small { color: var(--muted); font-size: 0.8rem; }
      .sb-ring { border-radius: 50%; display: grid; place-items: center; flex-shrink: 0; }
      .sb-stat .sb-ring span { background: var(--sand); }
      .sb-ring span { border-radius: 50%; background: var(--card); display: grid; place-items: center; font-weight: 700; font-size: 0.75rem; }
      .sb-bar { height: 6px; background: #ddd4c7; border-radius: 999px; margin-top: 12px; overflow: hidden; }
      .sb-bar div { height: 100%; background: var(--coral); border-radius: 999px; }

      .sb-upcoming { margin-top: 24px; }
      .sb-upcoming-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
      .sb-upcoming-card { background: var(--card); border: 1px solid var(--line); border-top: 4px solid; border-radius: 16px; padding: 14px 16px; display: flex; gap: 14px; align-items: center; }
      .sb-upcoming-code { font-family: 'Fraunces', serif; font-size: 1.1rem; font-weight: 700; }
      .sb-upcoming-task { font-size: 0.85rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .sb-changes { background: #e3f1ec; border: 1px solid #bfe0d6; color: #1f5e53; border-radius: 16px; padding: 14px 18px; margin-bottom: 16px; font-size: 0.9rem; }
      .sb-changes ul { margin: 6px 0 0; padding-left: 20px; }
      .sb-changes li { margin: 2px 0; }
      .sb-empty { text-align: center; padding: 40px 20px; }
      .sb-empty h3 { font-family: 'Fraunces', serif; font-size: 1.5rem; margin: 0 0 8px; }
      .sb-empty p { color: var(--muted); margin: 0 0 20px; }

      /* ---------- Small screens ---------- */
      @media (max-width: 900px) {
        .sb-app { grid-template-columns: 1fr; }
        .sb-side { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 12px; padding: 16px; }
        .sb-nav { flex-direction: row; flex-wrap: wrap; }
        .sb-nav a { padding: 8px 12px; }
        .sb-avail { display: none; }
        .sb-logout { margin-top: 0; margin-left: auto; }
        .sb-main { padding: 20px 16px 40px; }
        .sb-bottom { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="sb-app">
      <!-- ================= Sidebar ================= -->
      <aside class="sb-side">
        <a href="/study-plan" class="sb-logo">
          <span class="sb-logo-box">✦</span>
          <span>Study<span>Buddy</span></span>
        </a>

        <nav class="sb-nav">
          <a href="/study-plan" class="active">▦ Plan</a>
          <a href="/subjects/new">◈ Add subject</a>
          <a href="/study-plan/availability">◷ Study time</a>
          <a href="/profile">👤 Profile</a>
        </nav>

        <div class="sb-avail">
          <p class="sb-side-label">YOUR AVAILABILITY</p>
          <% if (user.availableStudyTimeHours) { %>
            <div><strong><%= user.availableStudyTimeHours %> h</strong> a day</div>
            <div>from <%= clock(user.studyStartTime) %></div>
          <% } else { %>
            <div>Not set yet</div>
          <% } %>
          <a href="/study-plan/availability">Edit times ↗</a>
        </div>

        <form class="sb-logout" action="/logout" method="POST">
          <button type="submit">Log out</button>
        </form>
      </aside>

      <!-- ================= Main ================= -->
      <main class="sb-main">
        <div class="sb-top">
          <div>
            <p class="sb-date"><%= todayLabel %></p>
            <h1 class="sb-title">Your study plan</h1>
          </div>
          <!-- Profile menu: click the avatar to open -->
          <details class="sb-profile">
            <summary class="sb-avatar" title="<%= displayName %>" aria-label="Open profile menu"><%= initials %></summary>
            <div class="sb-menu">
              <div class="sb-menu-head">
                <strong><%= displayName %></strong>
                <span><%= user.email %></span>
              </div>
              <a href="/profile">👤 Personal details</a>
              <a href="/study-plan/availability">◷ Study settings</a>
              <form action="/logout" method="POST">
                <button type="submit">↪ Log out</button>
              </form>
            </div>
          </details>
        </div>

        <!-- Subjects -->
        <div class="sb-subjects">
          <span class="sb-side-label" style="margin:0">YOUR SUBJECTS</span>
          <% subjects.forEach(function (subject) { %>
            <span class="sb-chip" style="background: <%= tint(subject.colour, '33') %>;">
              <i style="background: <%= subject.colour %>;"></i><%= subject.code || subject.name %>
            </span>
          <% }); %>
          <a href="/subjects/new" class="sb-chip sb-chip-add">+ Add</a>
        </div>

        <% if (changes && changes.length) { %>
          <!-- What changed after Regenerate (FR-15) -->
          <section class="sb-changes">
            <strong>✦ Plan updated. Here's what changed:</strong>
            <ul>
              <% changes.forEach(function (note) { %><li><%= note %></li><% }); %>
            </ul>
          </section>
        <% } %>

        <% if (!planView.hasPlan) { %>
          <!-- No plan yet -->
          <section class="sb-card sb-empty">
            <h3>No study plan yet</h3>
            <p>Add a subject and its tasks, set your study time, then generate your plan.</p>
            <div class="sb-actions" style="justify-content:center">
              <a class="sb-pill" href="/subjects/new">Add a subject</a>
              <a class="sb-pill" href="/study-plan/availability">Set study time</a>
              <button class="sb-pill primary" id="generate-plan">Generate my plan</button>
            </div>
          </section>
        <% } else { %>
          <section class="sb-card">
            <div class="sb-card-head">
              <div>
                <p class="sb-side-label" style="margin:0">
                  <%= currentView === 'list' ? 'FULL PLAN' : (dashboard.weekOffset === 0 ? 'THIS WEEK' : 'WEEK') %>
                </p>
                <h2>
                  <%= currentView === 'list'
                    ? planView.totalScheduledHours + ' hours across ' + planView.days.length + ' days'
                    : dashboard.weekLabel %>
                </h2>
              </div>
              <div class="sb-actions">
                <% if (currentView === 'calendar') { %>
                  <a class="sb-pill" href="/study-plan?week=<%= dashboard.weekOffset - 1 %>" aria-label="Previous week">‹</a>
                  <a class="sb-pill" href="/study-plan">Today</a>
                  <a class="sb-pill" href="/study-plan?week=<%= dashboard.weekOffset + 1 %>" aria-label="Next week">›</a>
                <% } %>
                <!-- List / Calendar toggle (FR-16) -->
                <div class="sb-toggle">
                  <a href="/study-plan?view=calendar" class="<%= currentView === 'calendar' ? 'active' : '' %>">Calendar</a>
                  <a href="/study-plan?view=list" class="<%= currentView === 'list' ? 'active' : '' %>">List</a>
                </div>
                <button class="sb-pill primary" id="generate-plan">Regenerate</button>
              </div>
            </div>

            <% if (currentView === 'calendar') { %>
              <%- include('calendarView', { dashboard: dashboard, tint: tint }) %>
            <% } else if (planView.days.length === 0) { %>
              <p class="sb-stat-small">Nothing left to study in this plan. Add a new task to get more sessions.</p>
            <% } else { %>
              <%- include('listView', { planView: planView }) %>
            <% } %>
          </section>

          <!-- Weekly progress + next deadline -->
          <div class="sb-bottom">
            <div class="sb-stat" style="display:flex; justify-content:space-between; align-items:center; gap:12px;">
              <div>
                <p class="sb-side-label" style="margin:0">WEEKLY PROGRESS</p>
                <div class="sb-stat-big"><%= dashboard.weeklyPercent %>%</div>
                <div class="sb-stat-small"><%= dashboard.completedHours %>h of <%= dashboard.plannedHours %>h planned this week</div>
              </div>
              <%- ring(dashboard.weeklyPercent, 'var(--coral)', 64) %>
            </div>

            <div class="sb-stat" style="display:flex; justify-content:space-between; align-items:center; gap:12px;">
              <div style="min-width:0">
                <p class="sb-side-label" style="margin:0">NEXT DEADLINE</p>
                <% if (dashboard.nextDeadline) { %>
                  <div class="sb-stat-big">
                    <%= dashboard.nextDeadline.subjectCode %>
                    <span class="sb-stat-small" style="font-family:'DM Sans',sans-serif">· <%= dashboard.nextDeadline.description %></span>
                  </div>
                  <div class="sb-stat-small"><%= dashboard.nextDeadline.dayLabel %> · <%= dashboard.nextDeadline.daysLeftLabel %></div>
                <% } else { %>
                  <div class="sb-stat-big">All clear</div>
                  <div class="sb-stat-small">No upcoming deadlines.</div>
                <% } %>
              </div>
              <% if (dashboard.nextDeadline) { %>
                <%- ring(dashboard.nextDeadline.percentDone, dashboard.nextDeadline.subjectColour, 64) %>
              <% } %>
            </div>
          </div>

          <!-- Next deadline for every subject -->
          <% if (dashboard.subjectDeadlines.length > 1) { %>
            <section class="sb-upcoming">
              <p class="sb-side-label">UPCOMING DEADLINES BY SUBJECT</p>
              <div class="sb-upcoming-grid">
                <% dashboard.subjectDeadlines.forEach(function (item) { %>
                  <div class="sb-upcoming-card" style="border-top-color: <%= item.subjectColour %>;">
                    <%- ring(item.percentDone, item.subjectColour, 56) %>
                    <div style="min-width:0">
                      <div class="sb-upcoming-code"><%= item.subjectCode %></div>
                      <div class="sb-upcoming-task" title="<%= item.description %>"><%= item.description %></div>
                      <div class="sb-stat-small">
                        <%= item.shortDayLabel %> · <%= item.daysLeftLabel %>
                      </div>
                      <div class="sb-stat-small">
                        <%= item.isScheduled ? item.hoursDone + 'h of ' + item.hoursPlanned + 'h done' : 'Not in plan yet, regenerate' %>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </section>
          <% } %>
        <% } %>
      </main>
    </div>

    <script>
      // Close the profile menu when clicking anywhere else on the page.
      document.addEventListener('click', function (event) {
        var menu = document.querySelector('.sb-profile');
        if (menu && menu.open && !menu.contains(event.target)) menu.open = false;
      });

      // Calls the generate endpoint, then reloads so the new plan shows.
      var generateButton = document.getElementById('generate-plan');
      if (generateButton) {
        generateButton.addEventListener('click', async function () {
          generateButton.disabled = true;
          try {
            var response = await fetch('/study-plan/generate', { method: 'POST' });
            var payload = await response.json();
            if (response.ok) {
              // Reload with ?regenerated=1 so the page shows what changed.
              var url = new URL(window.location.href);
              url.searchParams.set('regenerated', '1');
              window.location.href = url.toString();
            } else {
              alert(payload.message || 'Could not generate a plan.');
              generateButton.disabled = false;
            }
          } catch (error) {
            alert('Could not reach the server. Please try again.');
            generateButton.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>
