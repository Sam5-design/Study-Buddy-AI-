<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" />
<style>
  :root { --navy: #14233c; --coral: #e56b61; --cream: #f8f4ee; --sand: #efe7dc; --card: #fffdf9; --line: #e4ddd2; --muted: #7a8494; --green: #2e9e8f; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--navy); }
  a { color: inherit; }
  .wrap { max-width: 860px; margin: 0 auto; padding: 32px 16px 56px; }
  .back { font-weight: 600; text-decoration: none; font-size: 0.9rem; }
  h1 { font-family: 'Fraunces', serif; font-size: 2rem; margin: 18px 0 6px; }
  .muted { color: var(--muted); font-size: 0.9rem; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 20px 22px; margin-top: 16px; }
  .label { font-size: 0.7rem; letter-spacing: 0.12em; font-weight: 700; color: var(--muted); margin: 0 0 12px; }
  .btn { border: none; border-radius: 999px; padding: 9px 18px; font: inherit; font-weight: 600; cursor: pointer; background: var(--navy); color: #fff; text-decoration: none; display: inline-block; font-size: 0.85rem; }
  .btn.light { background: #fff; color: var(--navy); border: 1px solid var(--line); }
  .btn.danger { background: #fff; color: #b3423a; border: 1px solid #efc4bf; }
  .btn.small { padding: 5px 12px; font-size: 0.78rem; }
  .msg { border-radius: 12px; padding: 10px 14px; margin-top: 16px; font-size: 0.9rem; background: #e3f1ec; color: #1f5e53; }
  .msg.err { background: #fbe3e1; color: #b3423a; }
  .msg ul { margin: 4px 0 0; padding-left: 18px; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .actions form { margin: 0; }
  label.f { display: block; font-size: 0.8rem; font-weight: 600; color: var(--muted); margin: 14px 0 6px; }
  input[type=text], input[type=number], input[type=datetime-local], select, textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; font: inherit; background: #fff; color: var(--navy); }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
  .swatches { display: flex; gap: 10px; }
  .swatches label { cursor: pointer; }
  .swatches input { display: none; }
  .swatches span { display: block; width: 30px; height: 30px; border-radius: 50%; border: 3px solid transparent; }
  .swatches input:checked + span { border-color: var(--navy); }
  .pills { display: flex; gap: 8px; flex-wrap: wrap; }
  .pills label { border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; cursor: pointer; font-weight: 600; font-size: 0.85rem; background: #fff; }
  .pills input { margin-right: 6px; }
  @media (max-width: 560px) { .row2 { grid-template-columns: 1fr; } }
</style>
