    <main>
      <section class="hero section-pad" id="home">
        <div class="container hero-grid">
          <div class="hero-copy reveal">
            <p class="eyebrow"><span aria-hidden="true">✧</span> A calmer semester starts here</p>
            <h1>Study smarter.<br /><em>Stay on track.</em></h1>
            <p class="hero-lede">
              Turn your subjects, deadlines, tasks, and available time into a weekly study plan you can actually act on.
            </p>
            <div class="hero-actions">
              <a class="button" href="/register">Get Started <span aria-hidden="true">→</span></a>
              <a class="text-link" href="#how-it-works">See how it works <span aria-hidden="true">↘</span></a>
            </div>
            <div class="social-proof" aria-label="Study Buddy is designed with students">
              <div class="avatar-stack"><span>AM</span><span>JT</span><span>LS</span></div>
              <span>Made for real student schedules</span>
            </div>
          </div>

          <div class="hero-preview reveal reveal-delay-1" aria-label="Example Study Buddy weekly schedule">
            <div class="float-label label-top"><span class="spark">✦</span> Small steps count.</div>
            <div class="planner-card">
              <div class="planner-heading">
                <div><p class="mini-label">This week</p><h2>A week that fits.</h2></div>
                <span class="hours-pill"><span aria-hidden="true">✦</span> 10.5 hrs planned</span>
              </div>
              <div class="day-picker" role="tablist" aria-label="Choose a day">
                <button class="day is-active" role="tab" aria-selected="true" data-day="Monday"><small>Mon</small><strong>14</strong><i></i></button>
                <button class="day" role="tab" aria-selected="false" data-day="Tuesday"><small>Tue</small><strong>15</strong><i></i></button>
                <button class="day" role="tab" aria-selected="false" data-day="Wednesday"><small>Wed</small><strong>16</strong><i></i></button>
                <button class="day" role="tab" aria-selected="false" data-day="Thursday"><small>Thu</small><strong>17</strong><i></i></button>
                <button class="day" role="tab" aria-selected="false" data-day="Friday"><small>Fri</small><strong>18</strong><i></i></button>
                <button class="day" role="tab" aria-selected="false" data-day="Saturday"><small>Sat</small><strong>19</strong><i></i></button>
                <button class="day" role="tab" aria-selected="false" data-day="Sunday"><small>Sun</small><strong>20</strong><i></i></button>
              </div>
              <div class="planner-day-heading"><span id="hero-day-name">Monday</span><strong id="hero-day-hours">1.5h of focused time</strong><span>◷ &nbsp;6–9 PM</span></div>
              <div class="session-list">
                <div class="session session-coral"><span class="session-line"></span><div><strong id="hero-session-title">Read Ch. 04 notes</strong><small>6:00 PM · SIT725</small></div><span class="session-status">✓</span></div>
                <div class="session session-sage"><span class="session-line"></span><div><strong id="hero-open-title">Dinner + reset</strong><small>7:45 PM · Free time</small></div><span class="open-tag">open</span></div>
              </div>
              <div class="progress-row"><div><p class="mini-label">Weekly progress</p><div class="progress-track"><span></span></div></div><strong>78%</strong></div>
            </div>
            <div class="float-label label-bottom"><span class="check-badge">✓</span><div><strong>Plan feels lighter</strong><small>One week at a time</small></div></div>
          </div>
        </div>
